PORT=8787
LPS_ALLOWED_ORIGINS=https://ricardoprf.github.io

# AUTH V1: senha fica somente no servidor. O navegador recebe apenas um token temporário de sessão.
LPS_APP_PASSWORD=
LPS_SESSION_SECRET=

# AUTH corporativa futura (opcional): JWT via provedor de identidade.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Token interno opcional para integrações servidor-servidor. NÃO colocar no frontend público.
LPS_API_TOKEN=

# IA: a chave fica SOMENTE no servidor.
OPENAI_API_KEY=
OPENAI_MODEL=

# Criptografia AES-256-GCM: chaves base64 de 32 bytes.
LPS_DATA_KEY=
LPS_LEARNING_KEY=

# Retenção de arquivo bruto é DESABILITADA por padrão.
ALLOW_RAW_RETENTION=false
LPS_RETENTION_DIR=./private-retention

# Base de aprendizado anonimizado/criptografado.
LPS_LEARNING_STORE=./private-learning/events.ndjson.enc

PORT=8787
LPS_ALLOWED_ORIGINS=https://ricardoprf.github.io

# AUTH: configure um dos modos abaixo. Sem autenticação configurada, a API bloqueia rotas protegidas.
# Opção A: JWT via provedor de identidade (recomendado)
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Opção B: token apenas para ambiente técnico/testes. NÃO colocar no frontend público.
LPS_API_TOKEN=

# IA: a chave fica SOMENTE no servidor.
OPENAI_API_KEY=
OPENAI_MODEL=

# Criptografia AES-256-GCM: chaves base64 de 32 bytes.
LPS_DATA_KEY=
LPS_LEARNING_KEY=

# Retenção de arquivo bruto é DESABILITADA por padrão.
ALLOW_RAW_RETENTION=false
LPS_RETENTION_DIR=./private-retention

# Base de aprendizado anonimizado/criptografado.
LPS_LEARNING_STORE=./private-learning/events.ndjson.enc
